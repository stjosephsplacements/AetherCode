JUDGE_CONTROL_BOOTSTRAP_USER=
JUDGE_CONTROL_BOOTSTRAP_PASSWORD=
JUDGE_CONTROL_RABBITMQ_USER=
JUDGE_CONTROL_RABBITMQ_PASSWORD=
JUDGE_CONTROL_POSTGRES_PORT=55432
JUDGE_CONTROL_RABBITMQ_PORT=55672
JUDGE_CONTROL_RABBITMQ_MANAGEMENT_PORT=55673
