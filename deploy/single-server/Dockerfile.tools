# Operational tools for the single-server stack: database migrations, first
# administrator bootstrap and authorization-key rotation, plus every service's
# migrations. Built from the repository root.
ARG GO_BUILDER_IMAGE=golang:1.26.7@sha256:45a5f7a810238aabcbad211d70b9ae082022d96f7c7259e94041ad1b933575ac
FROM ${GO_BUILDER_IMAGE} AS build
WORKDIR /src
COPY backend/libs/pkg ./libs/pkg
COPY backend/libs/proto ./libs/proto
RUN cd libs/pkg \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/migrate ./cmd/migrate \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/bootstrap ./cmd/bootstrap \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/rotate-authz-key ./cmd/rotate-authz-key

FROM postgres:18.4
COPY --from=build /out/ /usr/local/bin/
COPY backend/services /tmp/services
RUN mkdir -p /migrations \
 && for dir in /tmp/services/*/migrations; do \
      service="$(basename "$(dirname "$dir")")"; cp -r "$dir" "/migrations/$service"; \
    done \
 && rm -rf /tmp/services
COPY deploy/single-server/migrate-all.sh /usr/local/bin/migrate-all
USER postgres
ENTRYPOINT ["/usr/local/bin/migrate-all"]
