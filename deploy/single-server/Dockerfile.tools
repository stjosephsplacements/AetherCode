# Operational tools for the single-server stack: database migrations, first
# administrator bootstrap, authorization-key rotation and out-of-band
# password-reset delivery, plus every service's migrations. Built from the repository root.
ARG GO_BUILDER_IMAGE=golang:1.26.10@sha256:672c944cfd07599b5f1bb179869270cdc94c6254e41db4d431259693cb286b82
FROM ${GO_BUILDER_IMAGE} AS build
WORKDIR /src
COPY backend/libs/pkg ./libs/pkg
COPY backend/libs/proto ./libs/proto
COPY backend/services/identity ./services/identity
RUN cd libs/pkg \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/migrate ./cmd/migrate \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/bootstrap ./cmd/bootstrap \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/rotate-authz-key ./cmd/rotate-authz-key \
 && cd ../../services/identity \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/deliver-reset ./cmd/deliver-reset

FROM postgres:18.4
COPY --from=build /out/ /usr/local/bin/
COPY backend/services /tmp/services
RUN mkdir -p /migrations \
 && for dir in /tmp/services/*/migrations; do \
      service="$(basename "$(dirname "$dir")")"; cp -r "$dir" "/migrations/$service"; \
    done \
 && rm -rf /tmp/services
COPY deploy/single-server/migrate-all.sh /usr/local/bin/migrate-all
COPY deploy/single-server/provision-keys.sh /usr/local/bin/provision-keys
USER postgres
# Migrate every database, then install its authorization capability key.
ENTRYPOINT ["/bin/sh", "-c", "migrate-all && provision-keys"]
