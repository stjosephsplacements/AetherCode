# Postgres for the question intake database (its own database; not the platform's).
DATABASE_URL=postgres://question_intake:CHANGE_ME@127.0.0.1:55433/question_intake
# The platform gateway: the same sign-in the platform uses (staff accounts only).
GATEWAY_URL=http://127.0.0.1:8380/api
# The hosted AetherCode Execution Engine used to verify model solutions.
ENGINE_URL=http://127.0.0.1:5100
# Signs "verified" tokens; any long random string.
VERIFY_SECRET=CHANGE_ME
# Set to true when served over HTTPS.
SECURE_COOKIES=false
