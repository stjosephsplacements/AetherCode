# Postgres connection for the app and worker.
DATABASE_URL=postgres://exam:exam@localhost:5432/exam
# Code execution engine: judge0 or piston.
ENGINE=judge0
ENGINE_URL=http://localhost:2358
# Optional Judge0 X-Auth-Token.
ENGINE_AUTH_TOKEN=
# Parallel test executions the worker sends to the engine.
WORKER_CONCURRENCY=8
# Set to "false" only when serving over plain HTTP on a trusted LAN.
COOKIE_SECURE=true

# Encrypts .seb launch files and is SEB's quit password (openssl rand -hex 24).
# Without it the .seb download returns 503.
SEB_CONFIG_PASSWORD=
