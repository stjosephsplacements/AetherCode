# Postgres connection for the app and worker.
DATABASE_URL=postgres://exam:exam@localhost:5432/exam
# Code execution engine: aethercode (default), judge0, or piston.
ENGINE=aethercode
ENGINE_URL=http://172.17.0.1:5100
# Optional auth token (not used by aethercode engine).
ENGINE_AUTH_TOKEN=
# Parallel test executions the worker sends to the engine.
WORKER_CONCURRENCY=8
# Set to "false" only when serving over plain HTTP on a trusted LAN.
COOKIE_SECURE=true
# Public origin students use, e.g. https://exam.example.edu. Optional: defaults to
# the proxied Host/X-Forwarded-Proto. SEB links and SEB request checks use it.
APP_URL=
# Quit password baked into generated SEB configs (students never type it).
SEB_CONFIG_PASSWORD=
