DB_PASSWORD=change-me
APP_PORT=80
# Plain HTTP on the campus LAN needs this false; set true behind HTTPS.
COOKIE_SECURE=false
# About 2x the Judge0 COUNT keeps every Judge0 worker busy.
WORKER_CONCURRENCY=32
ENGINE=judge0
ENGINE_URL=http://judge0-server:2358

# Encrypts .seb launch files and is SEB's quit password (openssl rand -hex 24).
# Without it the .seb download returns 503.
SEB_CONFIG_PASSWORD=
