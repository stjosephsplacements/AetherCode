DB_PASSWORD=change-me
APP_PORT=80
# Plain HTTP on the campus LAN needs this false; set true behind HTTPS.
COOKIE_SECURE=false
APP_URL=https://your-domain.example.com

# ---- Worker ----------------------------------------------------------------

# About 2x the engine's parallelism keeps every core busy.
WORKER_CONCURRENCY=32
# Max submissions claimed before the limiter throttles; default 2× concurrency.
# WORKER_MAX_IN_FLIGHT=64
# How many times to retry a failed submission before marking it error.
# WORKER_MAX_TRIES=3
# Milliseconds to sleep when the queue is empty.
# WORKER_IDLE_POLL_MS=250
# Truncate stdout/stderr stored in the DB to this many bytes.
# WORKER_OUTPUT_LIMIT_BYTES=8192

# ---- Engine selection ------------------------------------------------------

ENGINE=judge0
ENGINE_URL=http://judge0-server:2358
# ENGINE_AUTH_TOKEN=
# Set ENGINE_BATCH=false to disable Judge0 batch mode (compile-once path).
# ENGINE_BATCH=true

# ---- Judge0 tuning ---------------------------------------------------------
# All optional; defaults shown. Must stay within judge0.conf limits.

# How often to poll Judge0 for a result.
# ENGINE_JUDGE0_POLL_INTERVAL_MS=400
# Timeout waiting for a single-test result (ms); batch wall budget added on top.
# ENGINE_JUDGE0_POLL_DEADLINE_MS=120000
# Combined CPU budget (seconds) for one batched Judge0 job.
# ENGINE_JUDGE0_BATCH_CPU_BUDGET_SECONDS=100
# Wall-clock budget (seconds) for one batched Judge0 job.
# ENGINE_JUDGE0_BATCH_WALL_BUDGET_SECONDS=200
# Hard ceiling on per-test CPU time sent to Judge0 (seconds).
# ENGINE_JUDGE0_MAX_CPU_SECONDS=15
# Hard ceiling on memory sent to Judge0 (KB).
# ENGINE_JUDGE0_MAX_MEMORY_KB=512000

# ---- AetherCode engine tuning ----------------------------------------------
# All optional; defaults shown.

# Timeout waiting for the SSE stream to deliver a VERDICT (ms).
# ENGINE_AC_STREAM_TIMEOUT_MS=900000
# Hard ceiling/floor on time limits forwarded to the engine (ms).
# ENGINE_AC_MAX_TIME_LIMIT_MS=20000
# ENGINE_AC_MIN_TIME_LIMIT_MS=100
# Hard ceiling/floor on memory limits forwarded to the engine (KB).
# ENGINE_AC_MAX_MEMORY_LIMIT_KB=2097152
# ENGINE_AC_MIN_MEMORY_LIMIT_KB=16384
# Exponential-backoff retry delays on 429 from the engine (ms).
# ENGINE_AC_RETRY_INITIAL_DELAY_MS=2000
# ENGINE_AC_RETRY_MAX_DELAY_MS=60000
